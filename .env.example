# =========================================================================
# SMART AI PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. AI API Keys (Server-side Secrets)
# Required for Screenshot AI analysis and Scam Checker threat detection.
# In Cloudflare Pages: Add under Settings -> Environment variables -> Secrets.
# In Container / Node: Set in your host environment.
GEMINI_API_KEY="your-gemini-api-key-here"
# Optional alias
GOOGLE_API_KEY="your-gemini-api-key-here"

# 2. Public Canonical Domain
# The live production URL of your Cloudflare Pages deployment or custom domain.
# Examples: "https://smart-ai.pages.dev" or "https://smartai.tools"
# Used for canonical links, OpenGraph tags, dynamic sitemap.xml, and robots.txt.
PUBLIC_SITE_URL="https://smart-ai.pages.dev"

# 3. Companion Backend Service URL (Optional)
# If set in Cloudflare Pages, requests for native binary features
# (/api/background/*, /api/files/pdf-to-jpg, /api/files/*-word)
# are automatically reverse-proxied to this backend service.
# Example: "https://smart-ai-backend.onrender.com"
BACKEND_SERVICE_URL=""

# 4. Auth Secret (Optional)
# Used for HMAC token generation in Cloudflare Pages auth endpoints.
# Defaults to GEMINI_API_KEY if not explicitly specified.
AUTH_SECRET="your-secure-random-auth-secret-phrase"

# 5. Google Search Console Verification (Optional)
# In addition to the static verification file (public/google0fdc91d48d434718.html),
# this injects <meta name="google-site-verification" content="..." /> into HTML <head>.
GOOGLE_SITE_VERIFICATION=""

